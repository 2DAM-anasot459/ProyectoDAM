<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventarioActivos.Usuario.Mapa"
             xmlns:controls="clr-namespace:InventarioActivos.Views"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto"
          BackgroundColor="White">
        <!--Cabecera-->
        <Grid Grid.Row="0"
              BackgroundColor="#E53935"
              HeightRequest="60"
              Padding="16,10,16,10">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCerrarPopupTapped"/>
            </Grid.GestureRecognizers>
            <Label Text="{Binding Title}"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"/>
        </Grid>
        <!--Contenido-->
        <Border Grid.Row="1"
                Padding="10"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                BackgroundColor="White">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCerrarPopupTapped"/>
            </Border.GestureRecognizers>
            <!--Mapa con zoom/pan-->
            <Grid x:Name="VisorMapa"
                  IsClippedToBounds="True"
                  BackgroundColor="Transparent"
                  SizeChanged="OnVisorMapaSizeChanged">
                <Grid x:Name="ContenedorMapa"
                      AnchorX="0.5"
                      AnchorY="0.5"
                      BackgroundColor="Transparent">
                    <Image x:Name="ImagenMapa"
                           Source="mapa.png"
                           Aspect="AspectFit"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"/>

                    <!--Chinchetas-->
                    <AbsoluteLayout x:Name="PanelChinchetas"
                                    InputTransparent="False"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"/>
                    <Grid x:Name="OverlayPopup"
                          IsVisible="False"
                          InputTransparent="False"
                          HorizontalOptions="Fill"
                          VerticalOptions="Fill">
                        <Grid BackgroundColor="Transparent"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCerrarPopupTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>
 
                    <!--Bocadillo con nombre y botones-->
                        <AbsoluteLayout HorizontalOptions="Fill"
                                        VerticalOptions="Fill">
                            <Border x:Name="PopupActivo"
                                    IsVisible="False"                            
                                    BackgroundColor="#FFA000"
                                    Stroke="#F57C00"
                                    StrokeThickness="2"
                                    Padding="16"
                                    WidthRequest="280"
                                    HeightRequest="190">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15"/>
                                </Border.StrokeShape>

                                <Grid RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="12">
                                    <Label Grid.Row="0"
                                           Text="{Binding NombreActivoSeleccionado}"                              
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="Black"
                                           HorizontalOptions="Center"/>
                                    <Button Grid.Row="1"
                                            Text="Ver Activo"
                                            Command="{Binding VerActivoCommand}"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            CornerRadius="22"
                                            BackgroundColor="#1976D2"                               
                                            HeightRequest="44"/>
                                    <Button Grid.Row="2"
                                            Text="Crear Incidencia"
                                            Command="{Binding CrearIncidenciaCommand}"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            CornerRadius="22"
                                            BackgroundColor="#D32F2F"                               
                                            HeightRequest="44"/>
                                </Grid>
                            </Border>
                        </AbsoluteLayout>
                    </Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMapaTapped" NumberOfTapsRequired="1"/>
                        <TapGestureRecognizer Tapped="OnMapaDoubleTapped" NumberOfTapsRequired="2"/>
                        <PanGestureRecognizer PanUpdated="OnPanUpdate"/>
                        <PinchGestureRecognizer PinchUpdated="OnPinchUpdate"/>
                    </Grid.GestureRecognizers>
                </Grid>
            </Grid>
        </Border>
        <!--Barra de navegación-->
        <controls:BarraInferiorTec Grid.Row="2"
                                   HeightRequest="90"
                                   VerticalOptions="End"/>
    </Grid>
</ContentPage>