<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventarioActivos.Views.BarraInferiorTec">
    <!--Barra de navegación-->
    <Grid Grid.Row="2"
              BackgroundColor="#E53935"                  
              Padding="0,6"
              ColumnDefinitions="*,*,*,*">
        <!--Inicio-->
        <VerticalStackLayout Grid.Column="0"
                             Spacing="2"
                             HorizontalOptions="Center">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnInicioTapped"/>
            </VerticalStackLayout.GestureRecognizers>
            <Border BackgroundColor="White"
                    HeightRequest="40"
                    WidthRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Image Source="home.png"
                       HeightRequest="24"
                       WidthRequest="24"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>
            <Label Text="Inicio"
                   FontSize="12"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </VerticalStackLayout>
        <!--Activos-->
        <VerticalStackLayout Grid.Column="1"
                             Spacing="2"
                             HorizontalOptions="Center">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnActivosTapped"/>
            </VerticalStackLayout.GestureRecognizers>
            <Border BackgroundColor="White"
                    HeightRequest="40"
                    WidthRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Image Source="incidencias.png"
                       HeightRequest="24"
                       WidthRequest="24"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>
            <Label Text="Activos"
                   FontSize="12"
                   TextColor="White"/>
        </VerticalStackLayout>
        <!--Mapa-->
        <VerticalStackLayout Grid.Column="2"
                             Spacing="2"
                             HorizontalOptions="Center">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMapaTapped"/>
            </VerticalStackLayout.GestureRecognizers>
            <Border BackgroundColor="White"
                    HeightRequest="40"
                    WidthRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Image Source="localizacion.png"
                       HeightRequest="24"
                       WidthRequest="24"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>
            <Label Text="Mapa"
                   FontSize="12"
                   TextColor="White"/>
        </VerticalStackLayout>
        <!--Incidencias-->
        <VerticalStackLayout Grid.Column="3"
                             Spacing="2"
                             HorizontalOptions="Center">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnIncidenciaTapped"/>
            </VerticalStackLayout.GestureRecognizers>
            <Border BackgroundColor="White"
                    HeightRequest="40"
                    WidthRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Image Source="hoja.png"
                       HeightRequest="24"
                       WidthRequest="24"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>
            <Label Text="Incidencias"
                   FontSize="12"
                   TextColor="White"/>
        </VerticalStackLayout>
    </Grid>
</ContentView>