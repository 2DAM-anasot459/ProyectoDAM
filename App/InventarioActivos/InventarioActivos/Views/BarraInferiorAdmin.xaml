<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventarioActivos.Views.BarraInferiorAdmin">
    <!--Barra de navegación-->
    <Grid BackgroundColor="#E53935" 
          HeightRequest="90"
          VerticalOptions="End"
          Padding="0,6"
          ColumnDefinitions="*,*,*,*">
        <!--Inicio-->
        <VerticalStackLayout Grid.Column="0"
                             Spacing="2"
                             HorizontalOptions="Center">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnInicioTapped"/>
            </VerticalStackLayout.GestureRecognizers>
            <Border BackgroundColor="White"
                    HeightRequest="40"
                    WidthRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Image Source="home.png"
                       HeightRequest="24"
                       WidthRequest="24"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>
            <Label Text="Inicio"
                   FontSize="12"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </VerticalStackLayout>
        <!--Incidencias-->
        <VerticalStackLayout Grid.Column="1"
                             Spacing="2"
                             HorizontalOptions="Center">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnIncidenciasTapped"/>
            </VerticalStackLayout.GestureRecognizers>
            <Border BackgroundColor="White"
                    HeightRequest="40"
                    WidthRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Image Source="incidencias.png"
                       HeightRequest="24"
                       WidthRequest="24"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>
            <Label Text="Incidencias"
                   FontSize="12"
                   TextColor="White"/>
        </VerticalStackLayout>
        <!--Localización-->
        <VerticalStackLayout Grid.Column="2"
                             Spacing="2"
                             HorizontalOptions="Center">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLocalizacionTapped"/>
            </VerticalStackLayout.GestureRecognizers>
            <Border BackgroundColor="White"
                    HeightRequest="40"
                    WidthRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Image Source="localizacion.png"
                       HeightRequest="24"
                       WidthRequest="24"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>
            <Label Text="Localización"
                   FontSize="12"
                   TextColor="White"/>
        </VerticalStackLayout>
        <!--Usuarios-->
        <VerticalStackLayout Grid.Column="3"
                             Spacing="2"
                             HorizontalOptions="Center">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnUsuarioTapped"/>
            </VerticalStackLayout.GestureRecognizers>
            <Border BackgroundColor="White"
                    HeightRequest="40"
                    WidthRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Image Source="usuario.png"
                       HeightRequest="24"
                       WidthRequest="24"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>
            <Label Text="Usuario"
                   FontSize="12"
                   TextColor="White"/>
        </VerticalStackLayout>
    </Grid>
</ContentView>