<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventarioActivos.Administrador.CrearUsuario"
             xmlns:controls="clr-namespace:InventarioActivos.Views"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto"
           BackgroundColor="White">
        <!--Cabecera-->
        <Grid Grid.Row="0"
               BackgroundColor="#E53935"
               HeightRequest="60"
               Padding="16,10,16,10">
            <Label Text="{Binding Title}"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"/>
        </Grid>
        <!--Contenido-->
        <ScrollView Grid.Row="1">
            <Grid>
                <!--Tarjeta Nuevo Usuario-->
                <Border BackgroundColor="#FFEFEF"
                       Margin="16,16,16,32"
                       Padding="16,16"
                       HorizontalOptions="Fill"
                       VerticalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <!--Titulo-->
                        <Label Text="Nueva Usuario"
                              FontSize="24"
                              FontAttributes="Bold"
                              TextColor="#212121"
                              Margin="0,0,0,8"/>
                        <!--Nombre Usuario-->
                        <Label Text="Nombre"
                              FontSize="13"
                              TextColor="#555555"/>
                        <Border BackgroundColor="White"
                               Stroke="#DDDDDD"
                               StrokeThickness="1"
                               HeightRequest="44">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="Nombre Usuario"
                                  Text="{Binding Nombre}" 
                                  Margin="10,0"
                                  TextColor="Black"
                                  PlaceholderColor="#A0A0A0"/>
                        </Border>
                        <!--Apellidos Usuario-->
                        <Label Text="Apellidos"
                               FontSize="13"
                               TextColor="#555555"/>
                        <Border BackgroundColor="White"
                                Stroke="#DDDDDD"
                                StrokeThickness="1"
                                HeightRequest="44">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="Apellidos Usuario"
                                   Text="{Binding Apellidos}"
                                   Margin="10,0"
                                   TextColor="Black"
                                   PlaceholderColor="#A0A0A0"/>
                        </Border>
                        <!--Usuario (nombre de inicio de sesión)-->
                        <Label Text="Usuario"
                              FontSize="13"
                              TextColor="#555555"
                               Margin="0,8,0,0"/>
                        <Border BackgroundColor="White"
                               Stroke="#DDDDDD"
                               StrokeThickness="1"
                               HeightRequest="44">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="Nombre de Usuario"
                                  Text="{Binding NombreUsuario}"
                                  Margin="10,0"
                                  TextColor="Black"
                                  PlaceholderColor="#A0A0A0"/>
                        </Border>
                        <!--Contraseña-->
                        <Label Text="Contraseña"
                              FontSize="13"
                              TextColor="#555555"
                               Margin="0,8,0,0"/>
                        <Border BackgroundColor="White"
                               Stroke="#DDDDDD"
                               StrokeThickness="1"
                               HeightRequest="44">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="Contraseña"
                                  Text="{Binding Contrasena}"
                                  Margin="10,0"
                                  IsPassword="True"
                                  TextColor="Black"
                                  PlaceholderColor="#A0A0A0"/>
                        </Border>
                        <!--Tipo de usuario (Combo)-->
                        <Label Text="Tipo"
                              FontSize="13"
                              TextColor="#555555"
                               Margin="0,8,0,0"/>
                        <Border BackgroundColor="White"
                               Stroke="#DDDDDD"
                               StrokeThickness="1"
                               HeightRequest="44">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <Picker x:Name="PickerRoles"
                                      Title="Tipo de Usuario"
                                      ItemsSource="{Binding Roles}"
                                      SelectedItem="{Binding RolSeleccionado}"
                                      ItemDisplayBinding="{Binding NombreRol}"
                                      Margin="10,0"
                                      VerticalOptions="Center"
                                      TextColor="#A0A0A0"/>
                                <Image Grid.Column="1"
                                      Source="flechanavegar.png"
                                      HeightRequest="16"
                                      WidthRequest="16"
                                      Margin="0,0,10,0"
                                      VerticalOptions="Center"
                                      HorizontalOptions="End">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="AbrirRolTapped"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </Border>
                        <!--Botón Crear-->
                        <Button Text="Crear Usuario"
                               Command="{Binding CrearUsuarioCommand}"
                               Margin="0,16,0,0"
                               HeightRequest="50"
                               CornerRadius="25"
                               BackgroundColor="#1565C0"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Button Text="Volver"
                               Command="{Binding VolverCommand}"
                               Margin="0,16,0,0"
                               HeightRequest="50"
                               CornerRadius="25"
                               BackgroundColor="#1565C0"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="16"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
        <controls:BarraInferiorAdmin Grid.Row="2"
                             HeightRequest="90"
                             VerticalOptions="End"/>
    </Grid>
</ContentPage>