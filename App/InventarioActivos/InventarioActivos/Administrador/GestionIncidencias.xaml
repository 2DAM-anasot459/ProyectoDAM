<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventarioActivos.Administrador.GestionIncidencias"
             xmlns:controls="clr-namespace:InventarioActivos.Views"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto"
              BackgroundColor="White">
        <!--Cabecera-->
        <Grid Grid.Row="0"
                  BackgroundColor="#E53935"
                  HeightRequest="60"
                  Padding="16,10,16,10"
               ColumnDefinitions="*,Auto">
            <Label Text="{Binding Title}"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"/>
            <!--Icono Filtro-->
            <Border Grid.Column="1"
                    BackgroundColor="White"
                    HeightRequest="30"
                    WidthRequest="30"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleFiltroCommand}"/>
                </Border.GestureRecognizers>
                <Image Source="filtrar.png"
                       HeightRequest="16"
                       WidthRequest="16"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>
        </Grid>

        <!--Contenido de la página-->
        <Grid Grid.Row="1">
            <!--Aquí va el contenido de la gestión de incidencias-->
            <ScrollView>
                <VerticalStackLayout Padding="16,20"
                                     Spacing="16">
                    <CollectionView ItemsSource="{Binding Incidencias}"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding IncidenciaSeleccionada}"
                                    Margin="0,0,0,10">
                        <CollectionView.EmptyView>
                            <Label Text="No hay incidencias"
                                   TextColor="#616161"
                                   HorizontalOptions="Center"
                                   Margin="0,20,0,0"/>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#F2F2F2"
                                        Stroke="#BDBDBD"
                                        StrokeThickness="1"
                                        Padding="16"
                                        Margin="0,0,0,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0"
                                                             Spacing="8">
                                            <Label Text="{Binding Titulo}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#212121"/>
                                            <Label Text="{Binding Descripcion}"
                                                   FontSize="14"
                                                   TextColor="#616161"/>
                                            <Label Text="{Binding ActivoNombre}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#1D4ED8"/>
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1"
                                                BackgroundColor="{Binding EstadoColor}"
                                                Padding="8,4"
                                                VerticalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Estado}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <!--Espacio entre las tarjetas y los botones-->
                    <BoxView HeightRequest="1"/>
                    <!--Botones de acción-->
                    <Button Text="Crear Incidencia"
                            Command="{Binding CrearCommand}"
                            HeightRequest="48"
                            CornerRadius="24"
                            BackgroundColor="#43A047"
                            TextColor="White"
                            FontAttributes="Bold"/>
                    <Button Text="Editar Incidencia"
                            Command="{Binding EditarCommand}"
                            HeightRequest="48"
                            CornerRadius="24"
                            BackgroundColor="#FB8C00"
                            TextColor="White"
                            FontAttributes="Bold"/>
                    <Button Text="Eliminar Incidencia"
                            Command="{Binding EliminarCommand}"
                            HeightRequest="48"
                            CornerRadius="24"
                            BackgroundColor="#E53935"
                            TextColor="White"
                            FontAttributes="Bold"/>
                    <BoxView HeightRequest="1"/>
                </VerticalStackLayout>
            </ScrollView>
            <!--Paneles de Filtro-->
            <!--Panel principal-->
            <Border IsVisible="{Binding FiltroActivo}"
                    BackgroundColor="#FFEFEF"
                    Padding="16"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,10,10,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto, Auto">
                    <!--Filtro por Estado-->
                    <Grid RowSpacing="0"
                          RowDefinitions="Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirEstadoCommand}"/>
                        </Grid.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*"
                              Row="0"
                              Padding="0,0,0,8">
                            <Label Text="←"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   Margin="0,0,8,0"/>
                            <Label Text="Estado:"
                                   TextColor="Black"
                                   FontSize="14"
                                   VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1"
                                 VerticalOptions="Center"
                                 BackgroundColor="#D6D6D6"/>
                    </Grid>
                    <!--Filtro por Activo-->
                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto,*"
                          Padding="0,8,0,0">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirActivoCommand}"/>
                        </Grid.GestureRecognizers>
                        <Label Text="←"
                               FontSize="14"
                               VerticalOptions="Center"
                               Margin="0,0,8,0"/>
                        <Label Text="Activo"
                               TextColor="Black"
                               FontSize="14"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Button Grid.Row="2"
                            Text="Limpiar Filtros"
                            Command="{Binding LimpiarFiltrosCommand}"
                            BackgroundColor="#E53935"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="20"
                            CornerRadius="20"
                            Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <!--Panel Filtro Estado-->
            <Border IsVisible="{Binding FiltroEstadoActivo}"
                    BackgroundColor="#E8FDE8"
                    Padding="16"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Margin="0,70,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Terminada"
                           TextColor="Black"
                           FontSize="16">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SeleccionarEstadoCommand}"
                                                  CommandParameter="Terminada"/>
                        </Label.GestureRecognizers> 
                         
                    </Label>
                    <BoxView HeightRequest="1"
                             BackgroundColor="#C5E1A5" />
                    <Label Text="En Proceso"
                           TextColor="Black"
                           FontSize="16">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SeleccionarEstadoCommand}"
                                                  CommandParameter="EnProgreso"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <BoxView HeightRequest="1"
                             BackgroundColor="#C5E1A5" />
                    <Label Text="Pendiente"
                           TextColor="Black"
                           FontSize="16">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SeleccionarEstadoCommand}"
                                                  CommandParameter="Pendiente"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>
            <!--Panel Filtro Activo-->
            <Border IsVisible="{Binding FiltroActivosActivo}"
                    BackgroundColor="#E8FFFF"
                    Padding="16"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Margin="0,70,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,Auto">
                    <!-- Caja de búsqueda -->
                    <Border BackgroundColor="White"
                            Padding="10"
                            Grid.Column="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Entry Placeholder="Buscar activo..."
                               Text="{Binding TextoActivo}"
                               PlaceholderColor="#9CA3AF"
                               TextColor="Black" />
                    </Border>
                    <!-- Icono de búsqueda -->
                    <Border HeightRequest="40"
                            WidthRequest="40"
                            Grid.Column="1"
                            Margin="8,0,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BuscarActivoCommand}" />
                        </Border.GestureRecognizers>
                        <Image Source="lupa.png"
                                 HeightRequest="20"
                                 WidthRequest="20"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <controls:BarraInferiorAdmin Grid.Row="2"
                             HeightRequest="90"
                             VerticalOptions="End"/>
    </Grid>
</ContentPage>