<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventarioActivos.Administrador.AdministradorHome"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             xmlns:controls="clr-namespace:InventarioActivos.Views">

    <Grid RowDefinitions="Auto,*,Auto"
              BackgroundColor="White">

        <!--Cabecera-->
        <Grid Grid.Row="0"
                  BackgroundColor="#E53935"
                  HeightRequest="60"
                  Padding="16,10,16,10">
            <Label Text="{Binding Title}"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"/>
        </Grid>
        <!--Contenido con los tres botones-->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
                <VerticalStackLayout Grid.Row="1"
                                 Spacing="30"
                                 Padding="30,0"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                <!--Botón Gestión de Incidencias-->
                <Button Text="Gestión de Incidencias"
                        Command="{Binding IrIncidenciasCommand}"
                        Background="#FB8C00"
                        HeightRequest="60"
                        WidthRequest="260"
                        CornerRadius="16"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="White">
                </Button>

                <!--Botón Gestiçon de Localizaciones-->
                <Border Background="#43A047"
                        HeightRequest="60"
                        WidthRequest="260">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Label Text="Gestión de Localizaciones"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"/>
                </Border>

                <!--Botón Gestión de Usuarios-->
                <Border Background="#1E88E5"
                        HeightRequest="60"
                        WidthRequest="260">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Label Text="Gestión de Usuarios"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"/>
                </Border>
            </VerticalStackLayout>
        </Grid>
        <controls:BarraInferiorAdmin Grid.Row="2"/>
    </Grid>
</ContentPage>