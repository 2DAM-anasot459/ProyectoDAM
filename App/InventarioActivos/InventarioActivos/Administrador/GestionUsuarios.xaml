<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventarioActivos.Administrador.GestionUsuarios"
             xmlns:controls="clr-namespace:InventarioActivos.Views"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto"
              BackgroundColor="White">
        <!--Cabecera-->
        <Grid Grid.Row="0"
                  BackgroundColor="#E53935"
                  HeightRequest="60"
                  Padding="16,10,16,10">
            <Label Text="{Binding Title}"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"/>
        </Grid>
        <!--Contenido de la pagina-->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12"
                                 Padding="16,16,16,24">
                <!--Titulo-->
                <Label Text="Lista Usuario"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="#212121"
                       Margin="0,0,0,8"/>
                <!-- Buscador -->
                <Border BackgroundColor="White"
                    Stroke="#DDDDDD"
                    StrokeThickness="1"
                    HeightRequest="44">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry Placeholder="Buscar por nombre o apellidos..."
                       Margin="10,0"
                       Text="{Binding FiltroNombre}"
                       TextColor="Black"
                       PlaceholderColor="#A0A0A0"/>
                </Border>
                <!--Lista-->
                <CollectionView ItemsSource="{Binding Usuarios}"
                                Margin="0,8,0,0"
                                VerticalOptions="Fill">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#FFEFEF"
                                    Stroke="#DDDDDD"
                                    StrokeThickness="1"
                                    Padding="16"
                                    Margin="0,0,0,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">
                                    <!--Datos usuario-->
                                    <VerticalStackLayout Grid.Column="0"
                                             Spacing="2">
                                        <Label Text="{Binding Nombre}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#222222"/>    
                                        <Label Text="{Binding Apellidos}"
                                               FontSize="13"
                                               TextColor="#555555"/>
                                        <Label Text="{Binding TipoUsuario}"
                                               FontSize="13"
                                               TextColor="#555555"/>
                                    </VerticalStackLayout>
                                    <!--Iconos de editar y eliminar-->
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="12"
                                                         HorizontalOptions="End"
                                                         VerticalOptions="Center">
                                        <Image Source="lapiz.png"
                                               HeightRequest="24"
                                               WidthRequest="24"
                                               HorizontalOptions="End">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnEditarUsuarioTapped"/>
                                            </Image.GestureRecognizers>
                                        </Image>
                                        <Image Source="papelera.png"
                                               HeightRequest="24"
                                               WidthRequest="24"
                                               HorizontalOptions="End">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnEliminarUsuarioTapped"/>
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!--Boton añadir usuario-->
                <Button Text="Añadir Usuario"
                        HeightRequest="50"
                        CornerRadius="25"
                        BackgroundColor="#2E7D32"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        Margin="0,8,0,0"
                        Command="{Binding NuevoUsuarioCommand}"/>
            </VerticalStackLayout>
        </ScrollView>
        <controls:BarraInferiorAdmin Grid.Row="2"
                             HeightRequest="90"
                             VerticalOptions="End"/>
    </Grid>
</ContentPage>